---
// Inline SVG icons from lucide-static (ISC), resolved at build time. Decorative by default (aria-hidden).
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
const GITHUB = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.82-.26.82-.57v-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3"/></svg>';

interface Props { name: string; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: cls } = Astro.props;
const file = join(process.cwd(), "node_modules", "lucide-static", "icons", `${name}.svg`);
if (name !== "github" && !existsSync(file)) throw new Error(`Unknown icon: ${name}`);
let svg = name === "github" ? GITHUB : readFileSync(file, "utf8");
// Only the root <svg> tag is rewritten: inner <rect> elements keep their own width/height.
svg = svg
  .replace(/<!--[\s\S]*?-->/, "")
  .replace(/<svg[^>]*?>/, (tag) =>
    tag.replace(/\s(width|height|class)="[^"]*"/g, "").replace("<svg", `<svg width="${size}" height="${size}" class="icon${cls ? " " + cls : ""}" focusable="false" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'}`));
---
<Fragment set:html={svg.trim()} />
