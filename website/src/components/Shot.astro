---
// Responsive screenshot (WebP at several widths, explicit size to avoid layout shift).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: ImageMetadata; alt: string; sizes: string; widths?: number[]; eager?: boolean; class?: string }
const { src, alt, sizes, widths, eager = false, class: cls } = Astro.props;
const w = (widths ?? [480, 800, 1200, 1720]).filter((x) => x <= src.width);
---
<Image src={src} alt={alt} widths={w.length ? w : [src.width]} sizes={sizes} format="webp" quality={82}
  loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding={eager ? "sync" : "async"} class={cls} />
