---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { t, langPaths, type Lang } from "../../i18n";
import { getReleases, notesHtml, formatDate, formatSize, RELEASES_URL } from "../../lib/releases";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const c = d.changelog;
const { releases, live } = await getReleases();
---
<Base lang={lang} path="changelog/" title={c.title} description={c.description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="h1">{c.heading}</h1>
      <p class="lead">{c.sub} {d.common.notesLang}</p>
      {!live && <p class="note" style="margin-top:20px"><Icon name="circle-alert" size={18} /><span>{c.snapshotNote}</span></p>}
    </div>
  </section>
  <section class="divider">
    <div class="container">
      <ol class="timeline">
        {releases.map((r, i) => (
          <li id={r.tag}>
            <div class="when">
              <h2 class="h3"><a href={`#${r.tag}`}>Dynamic {r.version}</a></h2>
              <p class="muted small"><time datetime={r.date}>{formatDate(r.date, lang)}</time></p>
              {i === 0 && <span class="badge accent">{c.latest}</span>}
            </div>
            <div class="what">
              <div class="prose notes" set:html={notesHtml(r.notes)} />
              <p class="links">
                {r.installer && <a class="link" href={r.installer.url}><Icon name="download" size={16} />{c.installer} · {formatSize(r.installer.size, lang)}</a>}
                <a class="link" href={r.url}><Icon name="external-link" size={16} />GitHub</a>
              </p>
            </div>
          </li>
        ))}
      </ol>
      <p style="padding-bottom:var(--section)"><a class="btn btn-ghost" href={RELEASES_URL}><Icon name="github" size={18} />{d.common.allReleases}</a></p>
    </div>
  </section>
</Base>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; padding-block: 40px; border-bottom: 1px solid var(--border); }
  .when h2 a { text-decoration: none; }
  .when h2 a:hover { color: var(--accent); }
  .when p { margin: 6px 0 10px; }
  .notes { font-size: 1rem; }
  .notes :global(h3) { font-size: 1.0625rem; }
  .notes :global(h3:first-child) { margin-top: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 20px; margin: 20px 0 0; }
  @media (max-width: 760px) { .timeline li { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
</style>
